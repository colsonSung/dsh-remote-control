{
  "name": "dsh-remote-control",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "description": "Remote Control — drive this DeepSeek Harness agent from your phone through a Kimi-Code-style relay tunnel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/*.js",
    "src/vendor/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "license": "MIT",
  "author": "Ethan Song",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "remote-control",
    "kimi-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colsonSung/dsh-remote-control.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/colsonSung/dsh-remote-control#readme",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sync:contract": "node tools/sync-contract.js",
    "check:contract": "node tools/sync-contract.js --check",
    "build:yjs": "esbuild src/vendor/yjs-entry.mjs --bundle --format=iife --global-name=YShare --minify --outfile=src/vendor/yjs-browser.js --log-level=warning"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
